{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/health", "destination": "https://lane-4-ecommerce.onrender.com/health" },
    { "source": "/api/(.*)", "destination": "https://lane-4-ecommerce.onrender.com/api/$1" },
    { "source": "/api", "destination": "https://lane-4-ecommerce.onrender.com/api" },
    { "source": "/.wf_graphql/(.*)", "destination": "https://lane-4-ecommerce.onrender.com/.wf_graphql/$1" },
    { "source": "/.wf_graphql", "destination": "https://lane-4-ecommerce.onrender.com/.wf_graphql" },
    { "source": "/graphql", "destination": "https://lane-4-ecommerce.onrender.com/graphql" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/product/:slug.html", "destination": "/product/detail" },
    { "source": "/product/:slug", "destination": "/product/detail" },
    { "source": "/category/:cat/:subcat.html", "destination": "/category/detail" },
    { "source": "/category/:cat/:subcat", "destination": "/category/detail" },
    { "source": "/category/:slug.html", "destination": "/category/detail" },
    { "source": "/category/:slug", "destination": "/category/detail" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
