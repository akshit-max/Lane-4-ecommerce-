{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://lane4-backend.onrender.com/api/$1" },
    { "source": "/api", "destination": "https://lane4-backend.onrender.com/api" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/product/:slug.html", "destination": "/product/detail.html?slug=:slug" },
    { "source": "/product/:slug", "destination": "/product/detail.html?slug=:slug" },
    { "source": "/category/:slug.html", "destination": "/category/detail.html?slug=:slug" },
    { "source": "/category/:slug", "destination": "/category/detail.html?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
