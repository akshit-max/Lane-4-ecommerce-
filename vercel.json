{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://lane4-backend.onrender.com/api/$1" },
    { "source": "/api", "destination": "https://lane4-backend.onrender.com/api" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}

