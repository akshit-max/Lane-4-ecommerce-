# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# Firebase Admin SDK (Private Credentials)
# Set either FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, and FIREBASE_PRIVATE_KEY
# OR provide path to serviceAccountKey.json via GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Local Emulator (Optional for local testing without cloud credentials)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Public Firebase Web SDK Configuration (Served safely to frontend)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID_PUBLIC=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Delivery (SMTP / Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="The Lane4 Performance Store <Lane4performancestore@gmail.com>"

# Initial Admin Bootstrap
INITIAL_ADMIN_EMAIL=admin@lane4swim.in
INITIAL_ADMIN_PASSWORD=AdminSecurePass2026!

