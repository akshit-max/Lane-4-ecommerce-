# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# Firebase Admin SDK (Private Credentials)
# Set either FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, and FIREBASE_PRIVATE_KEY
# OR provide path to serviceAccountKey.json via GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Local Emulator (Optional for local testing without cloud credentials)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Public Firebase Web SDK Configuration (Served safely to frontend)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID_PUBLIC=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Cloudinary (Media Uploads - UPI Payment Receipts & Product Images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Delivery - Option A: Resend API (Recommended)
RESEND_API_KEY=
EMAIL_FROM="The Lane4 Performance Store <Lane4performancestore@gmail.com>"

# Email Delivery - Option B: SMTP / Nodemailer (Fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Staff Notifications
STAFF_NOTIFICATION_EMAIL=Lane4performancestore@gmail.com

# Initial Super Admin Bootstrap (Created on initial seed if not existing)
INITIAL_ADMIN_EMAIL=admin@lane4swim.in
INITIAL_ADMIN_PASSWORD=

# JWT Secrets & Expiry (REQUIRED IN PRODUCTION: Use 64-char cryptographically random strings)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRY_SECONDS=7200
CUSTOMER_JWT_SECRET=
CUSTOMER_JWT_EXPIRY_SECONDS=2592000

# GST & Compliance Configuration
SELLER_GSTIN=
REQUIRE_CERTIFIED_GST=false

# Cloud & Serverless Infrastructure Flags
ENABLE_STATIC_FILE_GENERATION=false
ENABLE_OUTBOX_WORKER=true
OUTBOX_POLL_INTERVAL_MS=60000

